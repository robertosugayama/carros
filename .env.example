# O padrão já é Firebase; não são necessárias variáveis Turso.
DATA_PROVIDER=firebase
VITE_DATA_PROVIDER=firebase
PORT=3000
# Apenas servidor. Nunca prefixe chaves com VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Opcionais SOMENTE para o modo legado SQL:
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
# MASTER_EMAIL=
# MASTER_PASSWORD=
