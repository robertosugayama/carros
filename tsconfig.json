{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "src",
    "server.ts",
    "legacyServer.ts",
    "firebaseServer.ts",
    "apiRuntime.ts",
    "masterAccount.ts",
    "imageEditing.ts",
    "wheelBackground.ts",
    "wheelExtraction.ts",
    "storageUpload.ts",
    "aiErrors.ts",
    "database.ts",
    "api",
    "promote.ts",
    "tests",
    "vite.config.ts"
  ]
}
